# InclusyQ Environment Variables

# ============================================================
# REDIS  (required for BullMQ + caching; falls back to in-memory when blank)
# ============================================================

# Redis connection string.
# Upstash:     rediss://:password@host:6380
# Redis Cloud: redis://:password@host:6379
# Local dev:   redis://localhost:6379
#
# Leave blank to use the in-memory fallback cache and NullQueue (in-process jobs).
REDIS_URL=

# ============================================================
# BULLMQ — Background Jobs
# ============================================================

# Worker concurrency per queue.
# Recommended: 3 email / 5 notification / 1 recalc / 10 audit
BULLMQ_EMAIL_CONCURRENCY=3
BULLMQ_NOTIFICATION_CONCURRENCY=5
BULLMQ_RECALC_CONCURRENCY=1
BULLMQ_AUDIT_CONCURRENCY=10

# Dead Letter Queue (DLQ) alerting
# Set a Slack incoming-webhook URL to receive alerts when jobs permanently fail.
# Leave blank to log only to console.
SLACK_DLQ_WEBHOOK=

# ============================================================
# SUPABASE
# ============================================================

# ── Frontend (browser-safe) ───────────────────────────────────────────────────
# These are baked into the Vite bundle at build time.
# Safe to expose — row-level security is enforced on the database.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Backend (server-only — NEVER expose to browser) ──────────────────────────
# SUPABASE_URL   — same URL as VITE_SUPABASE_URL but used by Node.js API functions
# SUPABASE_SERVICE_ROLE_KEY — has full DB access, bypasses RLS. Keep secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# On Vercel: set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in
#   Project Settings → Environment Variables (NOT prefixed with VITE_)

# ============================================================
# JWT AUTHENTICATION
# ============================================================

# JWT Secrets (required — no fallback; server fails fast without them)
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT Expiration
JWT_ACCESS_EXPIRES=15m      # Access token expires in 15 minutes
JWT_REFRESH_EXPIRES=7d      # Refresh token expires in 7 days

# ============================================================
# SECURITY SETTINGS
# ============================================================

# ── Account lockout (DB-level, per user) ─────────────────────────────────────
MAX_FAILED_ATTEMPTS=5              # Lock account after N wrong passwords
LOCKOUT_DURATION_MINUTES=15        # Minutes the account stays locked

# ── API rate limiting (network-level, per IP or username+IP) ─────────────────
# Login endpoint — keyed on username:IP so hospital shared IPs are safe
AUTH_MAX_ATTEMPTS=10               # Max login attempts per username+IP per window
AUTH_WINDOW_SECONDS=900            # Window duration (15 min)
AUTH_LOCKOUT_SECONDS=900           # Retry-After header value on 429

# Token refresh endpoint — keyed on IP only (higher quota, background calls)
REFRESH_MAX_ATTEMPTS=30            # Max refresh calls per IP per window
REFRESH_WINDOW_SECONDS=900         # Window duration (15 min)

# Session Management
MAX_CONCURRENT_SESSIONS=3          # Max simultaneous logins per user
SESSION_TIMEOUT_HOURS=24           # Session expires after N hours

# Password Hashing
BCRYPT_ROUNDS=12                   # Higher = more secure but slower (10-12 recommended)

# ── First-boot credential bootstrap (env only, used once) ────────────────────
# The server creates the default admin/reception accounts ONLY when they are
# missing AND these are set. Existing passwords are never overwritten.
# Leave unset after first boot. Never commit real values.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_RECEPTION_PASSWORD=

# ── Legacy passwordless header auth (default OFF — keep it off) ──────────────
# Set to 'true' only while a transitional legacy client still sends
# x-operator-username without a JWT. All clients should use Bearer tokens.
ALLOW_LEGACY_AUTH=

# ============================================================
# COOKIES
# ============================================================

# Cookie Domain (optional, for subdomain sharing)
# COOKIE_DOMAIN=.yourdomain.com

# ============================================================
# EMAIL (Nodemailer)
# ============================================================

# Email Service
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Email Sender
EMAIL_FROM=no-reply@inclusyq.com
EMAIL_FROM_NAME=InclusyQ Hospital

# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=production                 # 'development' or 'production'
APP_URL=http://localhost:5173       # Frontend URL
FRONTEND_URL=http://localhost:5173  # Same as APP_URL
PORT=3000

# ============================================================
# MONITORING & LOGGING
# ============================================================

LOG_LEVEL=info                      # 'debug', 'info', 'warn', 'error'

# ── Sentry error tracking ────────────────────────────────────────────────────
# Get DSN from https://sentry.io → Project → Settings → Client Keys
# Leave blank to disable Sentry (console logging still active).
SENTRY_DSN=

# ── Prometheus metrics ────────────────────────────────────────────────────────
# Bearer token protecting GET /api/metrics from public scraping.
# REQUIRED in production/staging — app must refuse to start without it
# (enforced by startup validation). Blank ONLY for local dev behind
# 127.0.0.1 port bindings (see docker-compose.yml).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Prometheus scrape side: bearer_token_file (see monitoring/prometheus.yml).
METRICS_TOKEN=

# ── Grafana (docker-compose monitoring) ─────────────────────────────────────
# REQUIRED — compose fails fast if unset (no default admin/admin password).
# Use a long random password; store the real values in a gitignored .env file,
# NOT in .env.example.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-password

# ── Performance thresholds ────────────────────────────────────────────────────
# Requests slower than this (ms) are flagged as [SLOW] in logs and counted in metrics.
SLOW_REQUEST_MS=1000
# Database queries slower than this (ms) are flagged as slow queries.
SLOW_QUERY_MS=200
# If Node.js heap exceeds this (MB), the /api/live liveness probe returns 503.
HEAP_LIMIT_MB=512

# ============================================================
# NOTES
# ============================================================

# 1. Copy this file to .env.local and fill in your values
# 2. Never commit .env.local to git
# 3. Generate secure JWT secrets for production
# 4. Use strong email passwords (app-specific passwords for Gmail)
# 5. Set NODE_ENV=production for production deployments

# CSRF: set to 'false' only for legacy non-browser clients that cannot
# send Authorization or x-requested-with headers. Default: block (secure).
STRICT_CSRF=
