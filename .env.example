# ──────────────────────────────────────────────────────────────────────────────
# InclusyQ — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, set these in: Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Public project URL (safe to expose to the browser)
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Anon (public) key — used by the browser client in TrackToken.tsx
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service role key — NEVER expose to the browser; only used in api/ serverless functions
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your account password.
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ── App URL ───────────────────────────────────────────────────────────────────
# Used for queue tracking links sent in emails.
# Local:      http://localhost:3000
# Production: https://your-project.vercel.app
APP_URL="https://your-project.vercel.app"

# ── Gemini AI (optional) ──────────────────────────────────────────────────────
# Required only if AI features are enabled.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── Local dev only ────────────────────────────────────────────────────────────
# PORT is only used by server.ts when running locally via `npm run dev`.
# Do NOT set this on Vercel.
PORT=3000
