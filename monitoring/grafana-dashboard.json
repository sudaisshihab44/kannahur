{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "InclusyQ Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel",      "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel",      "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "gauge",      "name": "Gauge",      "version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",      "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "InclusyQ API — HTTP, Database, Cache, Jobs, System",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100, "title": "── HTTP ──", "type": "row" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.5 },
          { "color": "red",    "value": 1 }
        ] },
        "unit": "s", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(iq_http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95 latency", "refId": "A" }],
      "title": "HTTP p95 Response Time", "type": "stat" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 50 },
          { "color": "red",    "value": 200 }
        ] },
        "unit": "reqps", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 }, "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "sum(rate(iq_http_requests_total[1m]))",
        "legendFormat": "req/s", "refId": "A" }],
      "title": "Request Rate", "type": "stat" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red",    "value": 5 }
        ] },
        "unit": "percent", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 }, "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "100 * sum(rate(iq_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(iq_http_requests_total[5m]))",
        "legendFormat": "error %", "refId": "A" }],
      "title": "HTTP 5xx Error Rate", "type": "stat" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": {
        "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "",
        "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line",
        "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false },
        "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
        "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false,
        "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
      }, "mappings": [], "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }, "id": 4,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(iq_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(iq_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(iq_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}", "refId": "C" }
      ],
      "title": "HTTP Response Time by Route (p50/p95/p99)", "type": "timeseries" },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101, "title": "── Database ──", "type": "row" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 0.1 },
          { "color": "red",    "value": 0.5 }
        ] }, "unit": "s", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 10 }, "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(iq_db_query_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95", "refId": "A" }],
      "title": "DB p95 Query Time", "type": "stat" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red",    "value": 10 }
        ] }, "unit": "short", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 10 }, "id": 6,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(iq_db_slow_queries_total[5m]))",
        "legendFormat": "slow queries/5m", "refId": "A" }],
      "title": "Slow Queries (5m)", "type": "stat" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": {
        "drawStyle": "line", "fillOpacity": 5, "lineInterpolation": "smooth",
        "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false
      }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 10 }, "id": 7,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(iq_db_query_duration_seconds_bucket[5m])) by (le, table, operation))",
          "legendFormat": "{{operation}} {{table}} p95", "refId": "A" }
      ],
      "title": "DB Query Time p95 by Table/Operation", "type": "timeseries" },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102, "title": "── System Resources ──", "type": "row" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "max": 100, "min": 0, "unit": "percent",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 70 },
          { "color": "red",    "value": 90 }
        ] } }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 19 }, "id": 8,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [{ "expr": "100 * iq_memory_heap_used_bytes / iq_memory_heap_total_bytes",
        "legendFormat": "Heap used %", "refId": "A" }],
      "title": "Heap Usage %", "type": "gauge" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": {
        "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth",
        "lineWidth": 2, "showPoints": "never", "spanNulls": false
      }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 19 }, "id": 9,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "iq_memory_heap_used_bytes",  "legendFormat": "Heap used",  "refId": "A" },
        { "expr": "iq_memory_heap_total_bytes", "legendFormat": "Heap total", "refId": "B" },
        { "expr": "iq_memory_rss_bytes",        "legendFormat": "RSS",        "refId": "C" }
      ],
      "title": "Memory (Heap + RSS)", "type": "timeseries" },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103, "title": "── BullMQ Jobs ──", "type": "row" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "red",    "value": 20 }
        ] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 26 }, "id": 10,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "sum(iq_job_queue_depth)",
        "legendFormat": "total waiting", "refId": "A" }],
      "title": "Total Jobs Queued", "type": "stat" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red",    "value": 5 }
        ] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 26 }, "id": 11,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(iq_job_failures_total[1h]))",
        "legendFormat": "failed/1h", "refId": "A" }],
      "title": "Job Failures (1h)", "type": "stat" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": {
        "drawStyle": "line", "fillOpacity": 5, "lineInterpolation": "smooth",
        "lineWidth": 2, "showPoints": "never"
      }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 }, "id": 12,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(iq_job_duration_seconds_bucket[5m])) by (le, queue, job_name))",
          "legendFormat": "{{queue}}/{{job_name}} p95", "refId": "A" }
      ],
      "title": "Job Duration p95 by Queue", "type": "timeseries" },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 104, "title": "── Domain (Tokens & Auth) ──", "type": "row" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": {
        "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never"
      }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 }, "id": 13,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum(increase(iq_token_actions_total[1h])) by (action)",
          "legendFormat": "{{action}}", "refId": "A" }
      ],
      "title": "Token Actions per Hour", "type": "timeseries" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": {
        "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never"
      }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 }, "id": 14,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum(increase(iq_auth_events_total[1h])) by (event)",
          "legendFormat": "{{event}}", "refId": "A" }
      ],
      "title": "Auth Events per Hour", "type": "timeseries" },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 105, "title": "── Cache ──", "type": "row" },

    { "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red",    "value": null },
          { "color": "yellow", "value": 50 },
          { "color": "green",  "value": 80 }
        ] }, "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 44 }, "id": 15,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [{ "expr": "100 * sum(rate(iq_cache_operations_total{operation=\"get\",result=\"hit\"}[5m])) / sum(rate(iq_cache_operations_total{operation=\"get\"}[5m]))",
        "legendFormat": "cache hit %", "refId": "A" }],
      "title": "Cache Hit Rate %", "type": "stat" }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["inclusyq", "production", "monitoring"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "InclusyQ Production Dashboard",
  "uid": "inclusyq-prod-v1",
  "version": 1
}
