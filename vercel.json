{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --frozen-lockfile",
  "framework": null,

  "rewrites": [
    { "source": "/api/admin/upload-logo", "destination": "/api/upload" },
    { "source": "/api/admin/:path*",       "destination": "/api/admin" },
    { "source": "/api/tokens/:path*",      "destination": "/api/tokens" },
    { "source": "/api/tokens",             "destination": "/api/tokens" },
    { "source": "/api/:path*",             "destination": "/api/index" },
    { "source": "/((?!api/).*)",           "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],

  "functions": {
    "api/index.ts":  { "maxDuration": 30, "includeFiles": "src-api/**" },
    "api/admin.ts":  { "maxDuration": 30, "includeFiles": "src-api/**" },
    "api/tokens.ts": { "maxDuration": 30, "includeFiles": "src-api/**" },
    "api/upload.ts": { "maxDuration": 60, "memory": 512, "includeFiles": "src-api/**" }
  },

  "crons": []
}
